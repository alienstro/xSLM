# Copy this file to .env and write the values. Never commit .env.

# A fine-grained token with write scope, limited to HF_REPO_ID only.
HF_TOKEN=
HF_REPO_ID=
MODEL_LICENSE=apache-2.0

# Weights and Biases. The training run continues if this value is absent.
WANDB_API_KEY=
WANDB_PROJECT=xslm

# The SSH connection string that the RunPod console shows. Keep the quotes,
# because the value holds spaces. pod.sh reads this file.
# Example: POD_SSH="root@213.173.98.10 -p 40123 -i ~/.ssh/id_ed25519"
POD_SSH=""

# RunPod. The key lets `pod.sh terminate` stop the pod when the run is finished,
# so that no pod keeps billing. Terminate always needs an explicit confirmation.
# Read the key at https://console.runpod.io/user/settings -> API Keys.
RUNPOD_API_KEY=
RUNPOD_POD_ID=
